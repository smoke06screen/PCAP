<?xml version="1.0" ?>
<sdf version="1.6">

  <world name="fcv_test_world">

    <!-- Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Textured ground -->
    <include>
      <uri>model://igvc_ground</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Gravity -->
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

  </world>

</sdf>
